# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas connection URL
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sports-meet?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=super-secret-sports-meet-saas-token-2024

# Base domain (for multi-tenant SaaS subdomain routing)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=sportsmeet.online
